# 后端环境变量示例 - 复制为 .env 并按需修改
# 也可直接在 shell 中 export 这些变量

# 数据库连接 URL（被 config/app.toml 与 migration 读取）
# 格式: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:root@localhost:5432/template2

# JWT 密钥（生产环境必须修改，建议使用 32+ 字符的随机字符串）
# 生成示例: openssl rand -base64 48
JWT_SECRET_KEY=please-change-me-in-production

# 多租户隔离模式: table (表隔离) | database (数据库隔离)
TENANT_MODE=table

# 微信开放平台「网站应用」（Web 扫码登录 qrconnect / 扫码绑定）
# 三个变量都配置后登录页的「微信扫码登录」才可用；未配置时接口返回明确中文错误
WECHAT_APPID=
WECHAT_SECRET=
# 授权回调地址：必须与开放平台后台登记的授权回调域一致（前端路由为 /login/wechat/callback）
WECHAT_OPEN_REDIRECT_URI=https://your-domain.com/login/wechat/callback
